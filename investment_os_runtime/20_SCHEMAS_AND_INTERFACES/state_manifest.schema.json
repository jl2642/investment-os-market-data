{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unified State Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "as_of",
    "promotion_status",
    "domains",
    "trade_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "promotion_status": {
      "enum": [
        "CANDIDATE",
        "PROMOTION_READY_NOT_ACTIVE",
        "CURRENT",
        "LKG",
        "REJECTED"
      ]
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain",
          "path",
          "rows",
          "sha256",
          "status"
        ]
      }
    },
    "trade_authority": {
      "const": "NONE"
    }
  },
  "additionalProperties": true
}
