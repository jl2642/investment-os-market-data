{
  "schema_version": "1.0.0",
  "contract_id": "P4_1_OPERATING_CURRENT_CONTRACT",
  "as_of": "2026-08-28",
  "status": "IMPLEMENTATION_CANDIDATE",
  "purpose": "Provide a low-risk operating authority surface for QC-passed public-data and research run pointers without using protected main merges as the daily data transport.",
  "authority": {
    "governance_canonical": {
      "branch": "main",
      "owns": [
        "code",
        "workflows",
        "model_and_strategy_contracts",
        "schemas_and_governance",
        "formal_candidate_membership",
        "protected_real_economic_state",
        "protected_simulation_economic_state",
        "user_approved_state_changes"
      ]
    },
    "operating_current": {
      "branch": "operating-current",
      "authoritative_prefix": "operating_current/",
      "inherited_repository_paths_authoritative": false,
      "may_mutate_protected_economic_state": false,
      "direct_main_push": false
    }
  },
  "pointer_rules": {
    "status_values": [
      "PASS",
      "FAIL",
      "BLOCKED",
      "NO_OP"
    ],
    "only_pass_may_advance_current": true,
    "failed_blocked_or_stale_run_may_replace_current": false,
    "source_commit_must_be_remote_reachable_before_advance": true,
    "watermark_sort_key_must_not_regress": true,
    "equal_watermark_refresh_allowed": true,
    "every_attempt_writes_receipt": true,
    "central_index_must_expose_current_pointer_and_latest_attempt": true
  },
  "initial_domains": [
    "A_SHARE_FULL_MARKET",
    "PORTFOLIO_MARKS",
    "CANDIDATE_WEEKLY_OBSERVATION",
    "RESEARCH_D2",
    "CROSS_MARKET_LIMITED"
  ],
  "permanent_boundaries": {
    "automatic_formal_candidate_membership_mutation": false,
    "automatic_real_account_mutation": false,
    "automatic_protected_simulation_mutation": false,
    "automatic_order_creation": false,
    "orders": 0,
    "trade_authority": "NONE"
  },
  "staleness_policy": {
    "basis": "CALENDAR_DAY_HEURISTIC_FOR_OPERATING_VISIBILITY_NOT_EXCHANGE_SESSION_TRUTH",
    "thresholds_calendar_days": {
      "A_SHARE_FULL_MARKET": 5,
      "PORTFOLIO_MARKS": 5,
      "CANDIDATE_WEEKLY_OBSERVATION": 10,
      "RESEARCH_D2": 10,
      "CROSS_MARKET_LIMITED": 5
    },
    "stale_status": "STALE_BY_CALENDAR_HEURISTIC",
    "missing_status": "MISSING_CURRENT",
    "stale_does_not_delete_last_known_good": true
  },
  "implementation_corrections": [
    {
      "id": "P4_1_CROSS_MARKET_PARTIAL_CAPTURE_FAIL_CLOSED_R1",
      "as_of": "2026-08-28",
      "trigger": "POST_MERGE_SOURCE_BRANCH_AUDIT_FOUND_PARTIAL_CROSS_MARKET_RUN_COULD_HAVE_ADVANCED_POINTER",
      "rule": "CROSS_MARKET_LIMITED_MAY_ADVANCE_ONLY_WHEN_CAPTURE_STATUS_EQUALS_CAPTURED_BOTH_MARKETS",
      "partial_treatment": "BLOCKED_RECEIPT_CURRENT_PRESERVED",
      "observed_bad_pointer_before_fix": false,
      "model_or_economic_state_change": false
    }
  ]
}
