    "require_exact_universe_membership_once": true,
    "minimum_non_bse_supported_ratio": 0.95,
    "maximum_non_bse_quarantine_ratio": 0.05,
    "minimum_official_pit_match_ratio": 0.9,
    "maximum_ambiguous_mapping_group_count": 0,
    "maximum_future_fact_count": 0,
    "maximum_source_less_decision_grade_fact_count": 0,
    "maximum_duplicate_effective_interval_count": 0,
    "maximum_unclassified_conflict_count": 0,
    "maximum_performed_validation_failure_count": 0,
    "require_controlled_validation_exclusions_classified": true,
    "require_affected_controlled_facts_removed_from_decision_grade": true,
    "require_bse_official_query_resolution": true,
    "require_zero_duplicate_symbols_across_shards": true,
    "require_normalized_release_hashes": true,
    "trade_authority": "NONE"
