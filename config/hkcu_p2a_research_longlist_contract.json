      "weights": {"dividend_yield_365d": 0.35, "earnings_yield": 0.25, "roe": 0.15, "liabilities_to_assets": 0.1, "volatility_60d": 0.15}
    },
    "TREND_LIQUIDITY": {
      "route": "CORE",
      "minimum_score": 0.42,
      "maximum_candidates": 90,
      "minimum_components": 6,
      "weights": {"return_60d": 0.18, "return_120d": 0.18, "momentum_250_20d": 0.14, "distance_52w_high": 0.14, "trend_consistency_60d": 0.12, "avg_turnover_hkd_20d": 0.12, "volatility_60d": 0.12}
    },
