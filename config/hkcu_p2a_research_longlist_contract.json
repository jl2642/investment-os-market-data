      "route": "CORE",
      "minimum_score": 0.4,
      "maximum_candidates": 80,
      "minimum_components": 4,
      "weights": {"volatility_60d": 0.25, "downside_volatility_60d": 0.15, "max_drawdown_120d": 0.2, "dividend_yield_365d": 0.15, "avg_turnover_hkd_20d": 0.1, "roe": 0.15}
    },
    "RECOVERY_WATCH": {
      "route": "WATCH",
      "minimum_score": 0.38,
      "maximum_candidates": 60,
      "minimum_components": 5,
      "weights": {"return_20d": 0.25, "return_60d": 0.2, "volume_ratio_20_60d": 0.15, "trend_consistency_60d": 0.15, "avg_turnover_hkd_20d": 0.1, "max_drawdown_120d": 0.15}
    }
  },
  "selection_policy": {
    "formal_five_sleeves_only": true,
    "balanced_fallback": "PROHIBITED",
    "cross_sleeve_bonus_per_extra_sleeve": 0.015,
    "cross_sleeve_bonus_maximum": 0.06,
    "distribution_method": "DETERMINISTIC_1D_KMEANS",
