  "sleeves": {
    "QUALITY_COMPOUNDER": {
      "route": "CORE",
      "minimum_score": 0.4,
      "maximum_candidates": 90,
      "minimum_components": 4,
      "weights": {"roe": 0.2, "roa": 0.1, "operating_margin": 0.15, "gross_margin": 0.1, "earnings_yield": 0.15, "revenue_yoy": 0.15, "net_income_yoy": 0.15}
    },
