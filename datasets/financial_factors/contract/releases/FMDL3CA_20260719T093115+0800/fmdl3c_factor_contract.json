    "operators": ["ADD", "SUBTRACT", "MULTIPLY", "DIVIDE", "ABS", "MAX", "MIN", "POWER"],
    "null_policy": "No implicit zero fill or neutral fill."
  },
  "denominator_policy": {
    "minimum_absolute_denominator": 1e-09,
    "positive_required_for_margin": true,
    "positive_required_for_cagr_start_and_end": true,
    "same_sign_required_for_profit_and_cash_growth": true,
    "negative_or_zero_equity_policy": "INVALID_DENOMINATOR",
    "negative_or_zero_assets_policy": "INVALID_DENOMINATOR",
    "zero_debt_policy": "Return NOT_APPLICABLE or a documented bounded state; never divide by zero.",
    "winsorization_policy": "No winsorization in the canonical raw factor value. Any later ranking transformation must preserve the raw value and transformation metadata."
  },
  "factor_families": [
    {"family_id": "PROFITABILITY", "purpose": "Operating and capital-return quality."},
    {"family_id": "EARNINGS_QUALITY", "purpose": "Cash conversion and accrual quality."},
    {"family_id": "GROWTH", "purpose": "Comparable same-period and multi-year growth."},
