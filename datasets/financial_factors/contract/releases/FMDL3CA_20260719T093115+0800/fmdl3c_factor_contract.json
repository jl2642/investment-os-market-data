{
  "contract_version": "1.0.0",
  "program_id": "FMDL-3C-A",
  "program_name": "Financial Factor Architecture & Contract Design",
  "architecture_state": "FROZEN_FOR_FMDL3C_B_EXECUTION",
  "business_timezone": "Asia/Shanghai",
  "entry_gate": {
    "pointer_path": "outputs/status/FMDL3B4_LAST_SUCCESS.json",
    "required_status": "FMDL3B4_POINT_IN_TIME_STATEMENT_STORE_ACCEPTED",
    "required_exit_gate": "POINT_IN_TIME_STATEMENT_STORE_ACCEPTED"
  },
  "purpose": "Define auditable point-in-time financial factor semantics over the accepted FMDL-3B Statement Current without creating investment or trade authority.",
  "scope": {
    "owned_domains": [
      "FACTOR_DEFINITION",
      "PIT_DERIVED_INPUT_CONSTRUCTION",
      "FACTOR_APPLICABILITY",
      "DENOMINATOR_VALIDITY",
      "COMPARABILITY_AND_RESTATEMENT_INHERITANCE",
      "FACTOR_QUALITY_STATE",
      "FACTOR_LINEAGE",
      "SECTOR_ROUTING_CONTRACT",
      "FACTOR_CURRENT_PUBLICATION_CONTRACT"
    ],
    "excluded_domains": [
      "CROSS_SECTIONAL_SCORE",
      "FACTOR_WEIGHT_OPTIMIZATION",
      "ALPHA_CLAIM",
      "COMPANY_RESEARCH_CONCLUSION",
      "CANDIDATE_POOL_PROMOTION",
      "PORTFOLIO_DECISION",
      "POSITION_SIZING",
      "TRADE_AUTHORITY",
      "WACC_ESTIMATION",
      "CONSENSUS_ESTIMATES"
    ]
  },
  "factor_grain": "one row per symbol, factor_id, as_of_timestamp, fiscal_period_end, factor_version",
  "input_contract": {
    "statement_current_pointer": "outputs/status/FMDL3B4_LAST_SUCCESS.json",
    "statement_catalog": "outputs/financials/statements/current/FMDL3B4_STATEMENT_CATALOG.csv",
    "required_statement_release_status": "FMDL3B4_POINT_IN_TIME_STATEMENT_STORE_ACCEPTED",
    "required_comparability_release_status": "FMDL3B3_COMPARABILITY_AND_RESTATEMENT_HARDENING_ACCEPTED",
    "raw_statement_field_registry": "config/fmdl3b_field_registry.json",
    "required_source_fact_state": "decision_grade_eligible=true",
    "required_trade_authority": "NONE",
    "component_missing_policy": "Every listed required component must be present. Missing debt, cash, goodwill or other balance components are never treated as zero."
  },
  "temporal_policy": {
    "as_of_rule": "Every factor is visible only after all required inputs are available and effective at the requested as_of_timestamp.",
    "derived_available_from_rule": "max(available_from of every required input)",
    "revision_rule": "Later restatements create later factor versions and never overwrite a factor visible before the restatement.",
    "pre_restatement_rule": "If FMDL-3B-3 blocks pre-restatement numeric replay, the derived factor is blocked for that historical as-of interval.",
    "ttm_rule": {
      "annual": "Use the accepted FY cumulative value.",
      "interim": "current YTD + prior FY - prior-year matching YTD",
      "required_comparability": "All three components must be decision-grade and comparable under FMDL-3B-3.",
      "available_from": "latest availability timestamp among all components"
    },
    "average_balance_rule": "(current period-end balance + same fiscal-period-type balance one year earlier) / 2",
    "growth_rule": "Compare the same fiscal period type and same canonical field across consecutive fiscal years only."
  },
  "quality_states": [
    "VALID",
    "VALID_WITH_WARNING",
    "NOT_APPLICABLE_SECTOR",
    "SECTOR_PROFILE_UNRESOLVED",
    "MISSING_REQUIRED_INPUT",
    "INVALID_DENOMINATOR",
    "INVALID_SIGN_TRANSITION",
    "NON_COMPARABLE_INPUT",
    "RESTATEMENT_REPLAY_BLOCKED",
    "STALE_INPUT",
    "CONFLICTED_INPUT",
    "QUARANTINED_INPUT"
  ],
  "rank_eligibility_policy": {
    "eligible_states": ["VALID"],
    "conditionally_eligible_states": ["VALID_WITH_WARNING"],
    "ineligible_states": [
      "NOT_APPLICABLE_SECTOR",
      "SECTOR_PROFILE_UNRESOLVED",
      "MISSING_REQUIRED_INPUT",
      "INVALID_DENOMINATOR",
      "INVALID_SIGN_TRANSITION",
      "NON_COMPARABLE_INPUT",
      "RESTATEMENT_REPLAY_BLOCKED",
      "STALE_INPUT",
      "CONFLICTED_INPUT",
      "QUARANTINED_INPUT"
    ],
    "note": "Cross-sectional scoring and weighting are deferred to FMDL-3C-D; this policy only preserves machine-readable eligibility."
  },
  "sector_profiles": {
    "required_profiles": [
      "GENERAL_NON_FINANCIAL",
      "BANK",
      "INSURANCE",
      "SECURITIES_AND_BROKERAGE",
      "UNRESOLVED"
    ],
    "routing_rule": "A sector-sensitive factor must not be calculated when sector_profile is UNRESOLVED.",
    "general_non_financial_rule": "Industrial profitability, cash conversion, working-capital and leverage factors apply only to GENERAL_NON_FINANCIAL unless an individual factor explicitly lists another profile.",
    "financial_sector_rule": "BANK, INSURANCE and SECURITIES_AND_BROKERAGE require specialized factor contracts; ordinary industrial leverage, current ratio, CFO conversion and gross-margin factors are not silently reused.",
    "shared_factor_rule": "ROE, ROA and parent-profit growth may apply across profiles only when the factor definition explicitly lists the profile and all denominator/comparability gates pass."
  },
  "formula_dsl": {
    "statement_tokens": [
      "revenue_ttm",
