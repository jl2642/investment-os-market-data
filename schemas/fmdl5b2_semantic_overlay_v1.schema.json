{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-os.local/schemas/fmdl5b2_semantic_overlay_v1.schema.json",
  "title": "FMDL-5B-2 HK Security Semantic Overlay Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "security_id",
    "issuer_id",
    "stock_code_5d",
    "official_security_name_en",
    "official_issuer_name_en",
    "issuer_identity_status",
    "issuer_identity_basis",
    "hkex_di_sid",
    "category",
    "sub_category",
    "security_type",
    "board_lot",
    "isin",
    "trading_currency",
    "rmb_counter_code",
    "dual_counter_flag",
    "wvr_flag",
    "secondary_listing_flag",
    "biotech_chapter18a_flag",
    "h_share_flag",
    "depositary_receipt_flag",
    "gem_flag",
    "source_release_id",
    "hkex_full_list_sha256",
    "di_response_sha256"
  ],
  "properties": {
    "security_id": {"type": "string", "pattern": "^HKEX:[0-9]{5}$"},
    "issuer_id": {"type": "string", "minLength": 10},
    "stock_code_5d": {"type": "string", "pattern": "^[0-9]{5}$"},
    "official_security_name_en": {"type": "string", "minLength": 1},
    "official_issuer_name_en": {"type": "string", "minLength": 1},
    "issuer_identity_status": {"enum": ["CONFIRMED", "UNRESOLVED"]},
    "issuer_identity_basis": {"enum": ["HKEX_DI_STOCK_CODE_CONFIRMED", "HKEX_SECURITY_MASTER_ISIN_CONFIRMED", "SECURITY_ANCHORED_UNRESOLVED"]},
    "hkex_di_sid": {"type": "string"},
    "category": {"type": "string", "minLength": 1},
    "sub_category": {"type": "string"},
    "security_type": {"enum": ["COMMON_EQUITY", "ETF", "REIT", "OTHER_LISTED_SECURITY"]},
    "board_lot": {"type": ["integer", "null"], "minimum": 1},
    "isin": {"type": "string"},
    "trading_currency": {"type": "string", "minLength": 3},
    "rmb_counter_code": {"type": "string", "pattern": "^$|^[0-9]{5}$"},
    "dual_counter_flag": {"type": "boolean"},
    "wvr_flag": {"type": "boolean"},
    "secondary_listing_flag": {"type": "boolean"},
    "biotech_chapter18a_flag": {"type": "boolean"},
    "h_share_flag": {"type": "boolean"},
    "depositary_receipt_flag": {"type": "boolean"},
    "gem_flag": {"type": "boolean"},
    "source_release_id": {"const": "FMDL5B1_20260720_d31e787a3ccd"},
    "hkex_full_list_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "di_response_sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}
  }
}
