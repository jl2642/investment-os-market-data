{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-os.local/schemas/fmdl3ea_baseline_manifest_v1.schema.json",
  "title": "FMDL-3E-A Canonical Baseline Manifest",
  "type": "object",
  "required": [
    "baseline_version",
    "baseline_id",
    "baseline_label",
    "generated_at",
    "status",
    "source_fmdl3d_release_id",
    "market_as_of_date",
    "universe_symbol_count",
    "symbol_set_sha256",
    "row_hash_set_sha256",
    "component_release_ids",
    "watermarks",
    "files",
    "authority",
    "trade_authority"
  ],
  "properties": {
    "baseline_version": {"const": "1.0.0"},
    "baseline_id": {"type": "string", "minLength": 8},
    "baseline_label": {"const": "FMDL3D_CANONICAL_BASELINE_0"},
    "generated_at": {"type": "string"},
    "status": {"const": "FROZEN_ACCEPTED_BASELINE"},
    "source_fmdl3d_release_id": {"type": "string", "minLength": 8},
    "market_as_of_date": {"type": "string", "format": "date"},
    "universe_symbol_count": {"type": "integer", "minimum": 1},
    "symbol_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_hash_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component_release_ids": {
      "type": "object",
      "required": ["FMDL-3D-A", "FMDL-3D-B", "FMDL-3D-C", "FMDL-3D-D"],
      "additionalProperties": {"type": "string"}
    },
    "watermarks": {
      "type": "object",
      "required": ["market", "universe", "financial", "capitalization", "valuation", "shareholder_return"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "authority": {"const": "DATA_AND_RESEARCH_EVIDENCE_ONLY"},
    "trade_authority": {"const": "NONE"}
  },
  "additionalProperties": true
}
