{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a_share_universe.schema.json",
  "title": "A-share Universe Row",
  "description": "Canonical row schema for the FMDL A-share security master.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of_date",
    "symbol",
    "source_symbol",
    "name",
    "exchange",
    "board",
    "currency",
    "security_type",
    "listing_status",
    "is_st",
    "is_suspended",
    "source_primary",
    "source_timestamp",
    "record_quality",
    "row_hash"
  ],
  "properties": {
    "as_of_date": {"type": "string", "format": "date"},
    "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"},
    "source_symbol": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "name_raw": {"type": ["string", "null"]},
    "exchange": {"type": "string", "enum": ["SH", "SZ", "BJ"]},
    "board": {"type": "string", "enum": ["SH_MAIN", "STAR", "SZ_MAIN", "CHINEXT", "BSE", "UNKNOWN"]},
    "currency": {"type": "string", "const": "CNY"},
    "security_type": {"type": "string", "const": "COMMON_STOCK"},
    "list_date": {"type": ["string", "null"], "format": "date"},
    "delist_date": {"type": ["string", "null"], "format": "date"},
    "listing_status": {"type": "string", "enum": ["ACTIVE", "SUSPENDED", "DELISTING", "DELISTED", "UNKNOWN"]},
    "is_st": {"type": "boolean"},
    "is_suspended": {"type": "boolean"},
    "industry_code": {"type": ["string", "null"]},
    "industry_name": {"type": ["string", "null"]},
    "industry_source": {"type": ["string", "null"]},
    "lot_size": {"type": ["integer", "null"], "minimum": 1},
    "source_primary": {"type": "string", "minLength": 1},
    "source_timestamp": {"type": "string", "format": "date-time"},
    "record_quality": {"type": "string", "enum": ["VALID", "PARTIAL", "STALE", "SUSPECT", "INVALID"]},
    "row_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
