{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-os.local/schemas/fmdl3_program_contract.schema.json",
  "title": "FMDL-3 Program Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "program_id",
    "program_name",
    "architecture_state",
    "business_timezone",
    "cost_policy",
    "scope",
    "point_in_time_contract",
    "source_policy",
    "sector_profiles",
    "canonical_datasets",
    "phase_sequence",
    "global_hard_gates",
    "publication_contract",
    "authority",
    "trade_authority",
    "next_phase"
  ],
  "properties": {
    "contract_version": {"type": "string", "const": "1.0.0"},
    "program_id": {"type": "string", "const": "FMDL-3"},
    "program_name": {"type": "string", "minLength": 1},
    "architecture_state": {"type": "string", "const": "FROZEN_FOR_FMDL3A_EXECUTION"},
    "business_timezone": {"type": "string", "const": "Asia/Shanghai"},
    "cost_policy": {"type": "string", "const": "FREE_AND_FREE_TIER_ONLY"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned_domains", "excluded_domains"],
      "properties": {
        "owned_domains": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "excluded_domains": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "point_in_time_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_temporal_fields", "as_of_rule", "restatement_rule", "date_fallback_rule", "zero_tolerance_failures"],
      "properties": {
        "required_temporal_fields": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}},
        "as_of_rule": {"type": "string", "minLength": 20},
        "restatement_rule": {"type": "string", "minLength": 20},
        "date_fallback_rule": {"type": "string", "minLength": 20},
        "zero_tolerance_failures": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_rank_order", "required_lineage_fields", "conflict_policy", "missing_policy", "raw_preservation_policy"],
      "properties": {
        "source_rank_order": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
        "required_lineage_fields": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}},
        "conflict_policy": {"type": "string", "minLength": 20},
        "missing_policy": {"type": "string", "minLength": 20},
        "raw_preservation_policy": {"type": "string", "minLength": 20}
      }
    },
    "sector_profiles": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "statement_model", "valuation_family", "status"],
        "properties": {
          "profile_id": {"type": "string"},
          "statement_model": {"type": "string"},
          "valuation_family": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "status": {"type": "string", "const": "REQUIRED"}
        }
      }
    },
    "canonical_datasets": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "phase_owner", "grain", "current_path", "required"],
        "properties": {
          "dataset_id": {"type": "string", "pattern": "^fmdl3_"},
          "phase_owner": {"type": "string", "pattern": "^FMDL-3[A-E]$"},
          "grain": {"type": "string", "minLength": 10},
          "current_path": {"type": "string", "pattern": "^outputs/.+/current/$"},
          "required": {"type": "boolean", "const": true}
        }
      }
    },
    "phase_sequence": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase_id", "name", "entry_gate", "exit_gate"],
        "properties": {
          "phase_id": {"type": "string", "pattern": "^FMDL-3[A-E]$"},
          "name": {"type": "string", "minLength": 5},
          "entry_gate": {"type": "string", "minLength": 5},
          "exit_gate": {"type": "string", "minLength": 5}
        }
      }
    },
    "global_hard_gates": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "publication_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_is_immutable",
        "current_requires_manifest",
        "last_known_good_required",
        "candidate_cannot_replace_current_on_failure",
        "point_in_time_replay_required_before_final_acceptance",
        "current_root",
        "status_pointer"
      ],
      "properties": {
        "archive_is_immutable": {"type": "boolean", "const": true},
        "current_requires_manifest": {"type": "boolean", "const": true},
        "last_known_good_required": {"type": "boolean", "const": true},
        "candidate_cannot_replace_current_on_failure": {"type": "boolean", "const": true},
        "point_in_time_replay_required_before_final_acceptance": {"type": "boolean", "const": true},
        "current_root": {"type": "string", "const": "outputs/fmdl3/current/"},
        "status_pointer": {"type": "string", "const": "outputs/status/FMDL3_LAST_SUCCESS.json"}
      }
    },
    "authority": {"type": "string", "const": "DATA_AND_RESEARCH_EVIDENCE_ONLY"},
    "trade_authority": {"type": "string", "const": "NONE"},
    "next_phase": {"type": "string", "const": "FMDL-3A"}
  }
}
