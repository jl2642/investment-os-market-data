{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-os.local/schemas/fmdl5e_longlist_v1.schema.json",
  "title": "FMDL-5E Hong Kong research-priority Longlist row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "as_of_date", "overall_rank", "research_priority", "security_id",
    "stock_code_5d", "official_security_name_en", "primary_sleeve",
    "aggregate_score", "investability_status", "next_workflow",
    "authority", "trade_authority"
  ],
  "properties": {
    "as_of_date": {"type": "string", "format": "date"},
    "overall_rank": {"type": "integer", "minimum": 1, "maximum": 100},
    "research_priority": {"enum": ["A_IMMEDIATE_RESEARCH", "B_WATCH_OR_TRIGGER", "C_SCREEN_FLAG_ONLY"]},
    "security_id": {"type": "string", "pattern": "^HKEX:"},
    "stock_code_5d": {"type": "string", "pattern": "^[0-9]{5}$"},
    "official_security_name_en": {"type": "string", "minLength": 1},
    "primary_sleeve": {"type": "string", "minLength": 1},
    "aggregate_score": {"type": "number", "minimum": 0},
    "investability_status": {"enum": ["ELIGIBLE_CORE", "ELIGIBLE_WATCH"]},
    "next_workflow": {"const": "FMDL-5F_PUBLIC_EQUITY_RESEARCH_ADAPTER"},
    "authority": {"const": "HK_FACTOR_AND_RESEARCH_PRIORITY_SCREEN_ONLY"},
    "trade_authority": {"const": "NONE"}
  }
}
