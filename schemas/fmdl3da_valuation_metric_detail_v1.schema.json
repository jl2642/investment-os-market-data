{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-os.local/schemas/fmdl3da_valuation_metric_detail_v1.schema.json",
  "title": "FMDL-3D-A Valuation Metric Detail",
  "type": "object",
  "required": [
    "symbol",
    "metric_id",
    "sector_profile",
    "market_as_of_date",
    "metric_state",
    "decision_grade_eligible",
    "source_release_id",
    "authority",
    "trade_authority"
  ],
  "properties": {
    "symbol": {"type": "string", "minLength": 6},
    "metric_id": {"type": "string", "minLength": 3},
    "sector_profile": {"type": "string"},
    "market_as_of_date": {"type": ["string", "null"], "format": "date"},
    "market_cutoff_timestamp": {"type": ["string", "null"]},
    "metric_value": {"type": ["number", "null"]},
    "output_unit": {"type": "string"},
    "metric_state": {
      "enum": [
        "VALID",
        "VALID_WITH_WARNING",
        "NOT_APPLICABLE_SECTOR",
        "CONTROLLED_CAPITALIZATION_QUARANTINE",
        "MISSING_REQUIRED_INPUT",
        "FUTURE_DENOMINATOR_BLOCKED",
        "NON_POSITIVE_EARNINGS",
        "NON_POSITIVE_BOOK_EQUITY",
        "NON_POSITIVE_REVENUE",
        "INVALID_ENTERPRISE_VALUE",
        "DEFERRED_TO_SHAREHOLDER_RETURN_LAYER"
      ]
    },
    "decision_grade_eligible": {"type": "boolean"},
    "denominator_period_end": {"type": ["string", "null"], "format": "date"},
    "denominator_available_from": {"type": ["string", "null"]},
    "required_inputs": {"type": "string"},
    "input_values_json": {"type": "string"},
    "input_states_json": {"type": "string"},
    "input_fact_ids_json": {"type": "string"},
    "capitalization_source_id": {"type": ["string", "null"]},
    "source_release_id": {"type": "string"},
    "lineage_id": {"type": "string"},
    "warning_codes": {"type": "string"},
    "authority": {"const": "DATA_AND_RESEARCH_EVIDENCE_ONLY"},
    "trade_authority": {"const": "NONE"}
  },
  "additionalProperties": true
}
