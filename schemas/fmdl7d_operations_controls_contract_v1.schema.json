{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fmdl7d_operations_controls_contract_v1.schema.json",
  "title": "FMDL-7D Scheduled Operations Controls Contract",
  "type": "object",
  "required": [
    "phase_id",
    "contract_version",
    "required_exit_status",
    "next_gate",
    "entry_gate",
    "source_bindings",
    "cadence_registry",
    "operating_runbook",
    "monitoring_controls",
    "staleness_policies",
    "cost_controls",
    "replay_scenarios",
    "escalation_rules",
    "failure_injections",
    "scope",
    "acceptance_gates",
    "storage_contract",
    "trade_authority"
  ],
  "properties": {
    "phase_id": {"const": "FMDL-7D"},
    "contract_version": {"type": "string"},
    "required_exit_status": {"const": "FMDL7D_SCHEDULED_OPERATIONS_MONITORING_STALENESS_AND_COST_CONTROLS_ACCEPTED"},
    "next_gate": {"const": "FMDL-7E_FAILURE_RECOVERY_CLEAN_ROOM_RESTORE_AND_CANONICAL_REFRESH"},
    "entry_gate": {"type": "object"},
    "source_bindings": {"type": "object", "minProperties": 7, "maxProperties": 7},
    "cadence_registry": {"type": "array", "minItems": 6, "maxItems": 6},
    "operating_runbook": {"type": "array", "minItems": 18, "maxItems": 18},
    "monitoring_controls": {"type": "array", "minItems": 16, "maxItems": 16},
    "staleness_policies": {"type": "array", "minItems": 12, "maxItems": 12},
    "cost_controls": {"type": "array", "minItems": 6, "maxItems": 6},
    "replay_scenarios": {"type": "array", "minItems": 12, "maxItems": 12},
    "escalation_rules": {"type": "array", "minItems": 12, "maxItems": 12},
    "failure_injections": {"type": "array", "minItems": 10, "maxItems": 10},
    "scope": {"type": "object"},
    "acceptance_gates": {"type": "object"},
    "storage_contract": {"type": "object"},
    "trade_authority": {"const": "NONE"}
  },
  "additionalProperties": true
}
