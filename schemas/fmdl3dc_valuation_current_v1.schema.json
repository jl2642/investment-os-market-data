{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fmdl3dc_valuation_current_v1.schema.json",
  "title": "FMDL-3D-C Valuation Current Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol", "name", "exchange", "board", "sector_profile",
    "market_as_of_date", "total_market_cap_cny", "float_market_cap_cny",
    "capitalization_state", "pe_ttm", "pe_ttm_state",
    "earnings_yield_ttm", "earnings_yield_ttm_state", "pb", "pb_state",
    "ps_ttm", "ps_ttm_state", "fcf_yield_ttm", "fcf_yield_ttm_state",
    "ev_sales_ttm", "ev_sales_ttm_state", "ev_operating_income_ttm",
    "ev_operating_income_ttm_state", "valid_metric_count",
    "decision_grade_metric_count", "valuation_version", "row_hash",
    "authority", "trade_authority"
  ],
  "properties": {
    "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"},
    "name": {"type": "string", "minLength": 1},
    "exchange": {"type": "string", "enum": ["SH", "SZ", "BJ"]},
    "board": {"type": "string", "enum": ["SH_MAIN", "SZ_MAIN", "STAR", "CHINEXT", "BSE", "UNKNOWN"]},
    "sector_profile": {"type": "string", "enum": ["GENERAL_NON_FINANCIAL", "BANK", "INSURANCE", "SECURITIES_AND_BROKERAGE", "UNRESOLVED"]},
    "market_as_of_date": {"type": "string", "format": "date"},
    "total_market_cap_cny": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "float_market_cap_cny": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "capitalization_state": {"type": "string", "minLength": 1},
    "pe_ttm": {"type": ["number", "null"]},
    "pe_ttm_state": {"type": "string"},
    "earnings_yield_ttm": {"type": ["number", "null"]},
    "earnings_yield_ttm_state": {"type": "string"},
    "pb": {"type": ["number", "null"]},
    "pb_state": {"type": "string"},
    "ps_ttm": {"type": ["number", "null"]},
    "ps_ttm_state": {"type": "string"},
    "fcf_yield_ttm": {"type": ["number", "null"]},
    "fcf_yield_ttm_state": {"type": "string"},
    "ev_sales_ttm": {"type": ["number", "null"]},
    "ev_sales_ttm_state": {"type": "string"},
    "ev_operating_income_ttm": {"type": ["number", "null"]},
    "ev_operating_income_ttm_state": {"type": "string"},
    "valid_metric_count": {"type": "integer", "minimum": 0, "maximum": 7},
    "decision_grade_metric_count": {"type": "integer", "minimum": 0, "maximum": 7},
    "valuation_version": {"type": "string", "minLength": 1},
    "row_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority": {"type": "string", "const": "DATA_AND_RESEARCH_EVIDENCE_ONLY"},
    "trade_authority": {"type": "string", "const": "NONE"}
  }
}
