{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fmdl3dc_valuation_metric_detail_v1.schema.json",
  "title": "FMDL-3D-C Valuation Metric Detail Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol", "name", "sector_profile", "metric_id", "metric_name",
    "metric_family", "valuation_version", "market_as_of_date",
    "market_cutoff_timestamp", "total_market_cap_cny", "metric_value",
    "output_unit", "quality_state", "warning_codes",
    "denominator_period_end", "denominator_available_from",
    "required_inputs", "input_values_json", "input_states_json",
    "input_available_from_json", "input_fact_ids_json", "formula",
    "capitalization_lineage_id", "metric_lineage_id", "decision_grade",
    "authority", "trade_authority"
  ],
  "properties": {
    "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"},
    "name": {"type": "string", "minLength": 1},
    "sector_profile": {"type": "string", "enum": ["GENERAL_NON_FINANCIAL", "BANK", "INSURANCE", "SECURITIES_AND_BROKERAGE", "UNRESOLVED"]},
    "metric_id": {"type": "string", "enum": ["VAL_PE_TTM", "VAL_EARNINGS_YIELD_TTM", "VAL_PB", "VAL_PS_TTM", "VAL_FCF_YIELD_TTM", "VAL_EV_SALES_TTM", "VAL_EV_OPERATING_INCOME_TTM"]},
    "metric_name": {"type": "string", "minLength": 1},
    "metric_family": {"type": "string", "const": "VALUATION"},
    "valuation_version": {"type": "string", "minLength": 1},
    "market_as_of_date": {"type": "string", "format": "date"},
    "market_cutoff_timestamp": {"type": "string", "format": "date-time"},
    "total_market_cap_cny": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "metric_value": {"type": ["number", "null"]},
    "output_unit": {"type": "string", "enum": ["RATIO"]},
    "quality_state": {"type": "string", "enum": ["VALID", "VALID_WITH_WARNING", "NOT_APPLICABLE_SECTOR", "SECTOR_PROFILE_UNRESOLVED", "CONTROLLED_CAPITALIZATION_QUARANTINE", "MISSING_REQUIRED_INPUT", "FUTURE_DENOMINATOR_BLOCKED", "NON_POSITIVE_EARNINGS", "NON_POSITIVE_BOOK_EQUITY", "NON_POSITIVE_REVENUE", "NON_POSITIVE_OPERATING_INCOME", "INVALID_ENTERPRISE_VALUE", "NON_COMPARABLE_INPUT", "CONFLICTED_INPUT", "QUARANTINED_INPUT", "STALE_INPUT"]},
    "warning_codes": {"type": "string"},
    "denominator_period_end": {"type": ["string", "null"], "format": "date"},
    "denominator_available_from": {"type": ["string", "null"]},
    "required_inputs": {"type": "string", "minLength": 1},
    "input_values_json": {"type": "string"},
    "input_states_json": {"type": "string"},
    "input_available_from_json": {"type": "string"},
    "input_fact_ids_json": {"type": "string"},
    "formula": {"type": "string", "minLength": 1},
    "capitalization_lineage_id": {"type": ["string", "null"]},
    "metric_lineage_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision_grade": {"type": "boolean"},
    "authority": {"type": "string", "const": "DATA_AND_RESEARCH_EVIDENCE_ONLY"},
    "trade_authority": {"type": "string", "const": "NONE"}
  }
}
