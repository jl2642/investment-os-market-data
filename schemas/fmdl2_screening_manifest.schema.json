{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fmdl2_screening_manifest.schema.json",
  "type": "object",
  "required": ["manifest_version","run_id","generated_at","as_of_date","factor_release_id","screening_contract_version","artifacts","aggregate_sha256","status","authority","stability_status"],
  "properties": {
    "manifest_version": {"type":"string"},
    "run_id":{"type":"string","pattern":"^FMDL2C_"},
    "generated_at":{"type":"string"},
    "as_of_date":{"type":"string","format":"date"},
    "factor_release_id":{"type":"string"},
    "screening_contract_version":{"type":"string"},
    "artifacts":{"type":"array","minItems":6,"items":{"type":"object","required":["dataset_id","path","sha256","row_count","bytes"]}},
    "aggregate_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "status":{"enum":["CANDIDATE_GENERATED","CANDIDATE_REJECTED"]},
    "authority":{"const":"RESEARCH_PRIORITY_ONLY_NO_TRADE_AUTHORITY"},
    "stability_status":{"const":"PENDING_FMDL2D"}
  },
  "additionalProperties": true
}
