  "required": [
    "program_id",
    "contract_version",
    "status",
    "authority",
    "trade_authority",
    "entry_gate",
    "source_bindings",
    "scope",
    "pool_requirements",
    "identity_policy",
    "listing_validation",
    "pool",
    "acceptance_gates",
    "publication",
    "exit_status",
    "next_gate"
