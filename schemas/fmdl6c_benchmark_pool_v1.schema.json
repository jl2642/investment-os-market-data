    "pool": {
      "items": {
        "properties": {
          "benchmark_only": {
            "const": true
          },
          "canonical_listing_key": {
            "type": "null"
          },
          "cik10": {
            "pattern": "^[0-9]{10}$",
            "type": "string"
          },
          "instrument_type": {
            "enum": [
              "COMMON_STOCK",
              "ADR",
              "FOREIGN_PRIVATE_ISSUER_ORDINARY",
              "EQUITY_REIT_COMMON"
            ]
          },
          "investment_eligible": {
            "const": false
          },
          "listing_history_status": {
            "const": "CURRENT_SNAPSHOT_ONLY"
          },
          "mic": {
            "enum": [
              "XNAS",
              "XNYS",
              "XASE"
            ]
          },
          "pool_order": {
            "maximum": 24,
            "minimum": 1,
            "type": "integer"
          },
          "research_candidate": {
            "const": false
          },
          "trade_authority": {
            "const": "NONE"
          }
        },
        "required": [
          "pool_order",
          "ticker",
          "directory_symbol",
          "name",
          "cik10",
          "mic",
          "instrument_type",
          "issuer_key",
          "share_class_key",
          "security_key",
          "listing_observation_key",
          "canonical_listing_key",
          "listing_observed_active_on",
          "listing_history_status",
          "reporting_profile",
          "case_tags",
          "benchmark_only",
          "investment_eligible",
          "research_candidate",
          "trade_authority"
        ],
        "type": "object"
      },
      "maxItems": 24,
      "minItems": 24,
      "type": "array"
    },
    "program_id": {
      "const": "FMDL-6C"
    },
    "publication": {
      "properties": {
        "release_sequence": {
          "const": 22
        }
      },
      "type": "object"
    },
    "scope": {
      "properties": {
        "candidate_pool_integration_authorized": {
          "const": false
        },
        "factor_or_screening_build_authorized": {
          "const": false
        },
        "financial_fact_normalization_authorized": {
          "const": false
        },
        "full_universe_build_authorized": {
          "const": false
        },
        "historical_warehouse_build_authorized": {
          "const": false
        },
        "mode": {
          "const": "24_SECURITY_TECHNICAL_BENCHMARK_ONLY"
        },
        "order_generation_authorized": {
          "const": false
        },
        "real_account_integration_authorized": {
          "const": false
        },
        "research_longlist_authorized": {
          "const": false
        },
        "security_count": {
          "const": 24
        },
        "simulation_integration_authorized": {
          "const": false
        }
      },
      "required": [
        "mode",
        "security_count",
        "full_universe_build_authorized",
        "historical_warehouse_build_authorized",
        "financial_fact_normalization_authorized",
        "factor_or_screening_build_authorized",
        "research_longlist_authorized",
        "candidate_pool_integration_authorized",
        "simulation_integration_authorized",
        "real_account_integration_authorized",
        "order_generation_authorized"
