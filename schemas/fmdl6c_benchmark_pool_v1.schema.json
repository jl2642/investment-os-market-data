{
  "$id": "https://example.local/schemas/fmdl6c_benchmark_pool_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "authority": {
      "const": "TECHNICAL_BENCHMARK_POOL_ONLY"
    },
    "exit_status": {
      "const": "FMDL6C_24_SECURITY_BENCHMARK_POOL_ACCEPTED"
    },
    "next_gate": {
      "const": "FMDL-6D_MINIMAL_END_TO_END_DATA_CHAIN"
