{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["phase_id", "domain_contracts", "reconciliation_contract", "completion_boundary", "storage_contract", "trade_authority", "required_exit_status", "next_gate"],
  "properties": {
    "phase_id": {"const": "FMDL-6X2-FINAL"},
    "trade_authority": {"const": "NONE"},
    "required_exit_status": {"const": "FMDL6X2_FINAL_FULL_STORE_RECONCILIATION_AND_OPERATIONAL_ACCEPTANCE_ACCEPTED"},
    "next_gate": {"const": "FMDL-6X3-A_RESEARCH_UNIVERSE_AND_DATA_READINESS_CONTRACT"},
    "domain_contracts": {"type": "object", "minProperties": 5, "maxProperties": 5},
    "storage_contract": {"type": "object", "required": ["release_sequence", "current_root", "release_root", "last_success", "last_known_good"]}
  }
}
