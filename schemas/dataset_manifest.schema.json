{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset_manifest.schema.json",
  "title": "FMDL Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "dataset_id",
    "dataset_version",
    "schema_id",
    "schema_version",
    "run_id",
    "as_of_date",
    "generated_at",
    "business_timezone",
    "publication_status",
    "qa_status",
    "sources",
    "row_count",
    "column_count",
    "file",
    "quality",
    "lineage"
  ],
  "properties": {
    "manifest_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "dataset_id": {"type": "string", "enum": ["a_share_universe", "daily_market_snapshot", "trading_calendar"]},
    "dataset_version": {"type": "string", "minLength": 1},
    "schema_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "as_of_date": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "business_timezone": {"type": "string", "const": "Asia/Shanghai"},
    "publication_status": {"type": "string", "enum": ["CANDIDATE", "READY", "DEGRADED", "QUARANTINED", "FAILED", "PUBLISHED"]},
    "qa_status": {"type": "string", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL", "NOT_RUN"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter_id", "adapter_function", "retrieved_at"],
        "properties": {
          "adapter_id": {"type": "string"},
          "adapter_version": {"type": ["string", "null"]},
          "adapter_function": {"type": "string"},
          "provider_id": {"type": ["string", "null"]},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "source_as_of_date": {"type": ["string", "null"], "format": "date"},
          "raw_hash_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "retries": {"type": "integer", "minimum": 0},
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "row_count": {"type": "integer", "minimum": 0},
    "column_count": {"type": "integer", "minimum": 1},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_failures", "soft_warnings", "gate_results_path"],
      "properties": {
        "hard_failures": {"type": "array", "items": {"type": "string"}},
        "soft_warnings": {"type": "array", "items": {"type": "string"}},
        "gate_results_path": {"type": "string"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent_dataset_version", "last_known_good_dataset_version"],
      "properties": {
        "parent_dataset_version": {"type": ["string", "null"]},
        "last_known_good_dataset_version": {"type": ["string", "null"]}
      }
    },
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  }
}
