{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily_market_snapshot.schema.json",
  "title": "A-share Daily Market Snapshot Row",
  "description": "Canonical row schema for a completed A-share trading session snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of_date",
    "symbol",
    "close",
    "prev_close",
    "pct_change",
    "volume_shares",
    "turnover_cny",
    "data_status",
    "source_primary",
    "source_timestamp",
    "record_quality",
    "row_hash"
  ],
  "properties": {
    "as_of_date": {"type": "string", "format": "date"},
    "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"},
    "open": {"type": ["number", "null"], "minimum": 0},
    "high": {"type": ["number", "null"], "minimum": 0},
    "low": {"type": ["number", "null"], "minimum": 0},
    "close": {"type": ["number", "null"], "minimum": 0},
    "prev_close": {"type": ["number", "null"], "minimum": 0},
    "pct_change": {"type": ["number", "null"]},
    "amplitude_pct": {"type": ["number", "null"], "minimum": 0},
    "volume_shares": {"type": ["number", "null"], "minimum": 0},
    "turnover_cny": {"type": ["number", "null"], "minimum": 0},
    "turnover_rate_pct": {"type": ["number", "null"], "minimum": 0},
    "market_cap_cny": {"type": ["number", "null"], "minimum": 0},
    "float_market_cap_cny": {"type": ["number", "null"], "minimum": 0},
    "pe_ttm": {"type": ["number", "null"]},
    "pb": {"type": ["number", "null"]},
    "data_status": {"type": "string", "enum": ["TRADED", "SUSPENDED", "NO_DATA", "NOT_LISTED", "UNKNOWN"]},
    "source_primary": {"type": "string", "minLength": 1},
    "source_timestamp": {"type": "string", "format": "date-time"},
    "record_quality": {"type": "string", "enum": ["VALID", "PARTIAL", "STALE", "SUSPECT", "INVALID"]},
    "row_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
