{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-os.local/schemas/fmdl3da_shareholder_return_event_v1.schema.json",
  "title": "FMDL-3D-A Shareholder Return Event",
  "type": "object",
  "required": [
    "event_id",
    "symbol",
    "event_type",
    "event_stage",
    "announcement_date",
    "source_document_id",
    "share_count_effective",
    "shareholder_yield_effective",
    "authority",
    "trade_authority"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 8},
    "symbol": {"type": "string", "minLength": 6},
    "event_type": {
      "enum": [
        "CASH_DIVIDEND",
        "BUYBACK",
        "SHARE_CANCELLATION",
        "PRIVATE_PLACEMENT",
        "RIGHTS_ISSUE",
        "CONVERTIBLE_CONVERSION",
        "EQUITY_INCENTIVE_ISSUANCE",
        "STOCK_DIVIDEND_OR_SPLIT"
      ]
    },
    "event_stage": {
      "enum": [
        "ANNOUNCED",
        "BOARD_APPROVED",
        "SHAREHOLDER_APPROVED",
        "REGULATORY_APPROVED",
        "IN_PROGRESS",
        "IMPLEMENTED",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "announcement_date": {"type": "string", "format": "date"},
    "effective_date": {"type": ["string", "null"], "format": "date"},
    "implementation_date": {"type": ["string", "null"], "format": "date"},
    "completion_date": {"type": ["string", "null"], "format": "date"},
    "source_document_id": {"type": "string", "minLength": 1},
    "source_location": {"type": ["string", "null"]},
    "cash_amount_total_cny": {"type": ["number", "null"]},
    "cash_amount_per_share": {"type": ["number", "null"]},
    "completed_cash_amount_cny": {"type": ["number", "null"]},
    "completed_share_count": {"type": ["number", "null"]},
    "issued_share_count": {"type": ["number", "null"]},
    "gross_proceeds_cny": {"type": ["number", "null"]},
    "converted_share_count": {"type": ["number", "null"]},
    "share_multiplier": {"type": ["number", "null"]},
    "share_count_effective": {"type": "boolean"},
    "shareholder_yield_effective": {"type": "boolean"},
    "lineage_id": {"type": "string"},
    "authority": {"const": "DATA_AND_RESEARCH_EVIDENCE_ONLY"},
    "trade_authority": {"const": "NONE"}
  },
  "additionalProperties": true
}
