{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMDL-3D-D Shareholder Return Event",
  "type": "object",
  "required": ["event_id", "symbol", "event_type", "event_stage", "announcement_date", "effective_date", "event_state", "shareholder_yield_effective", "source_id", "source_adapter", "source_row_hash", "authority", "trade_authority"],
  "properties": {
    "event_id": {"type": "string"},
    "symbol": {"type": "string"},
    "name": {"type": ["string", "null"]},
    "event_type": {"type": "string"},
    "event_stage": {"type": "string"},
    "announcement_date": {"type": "string", "format": "date"},
    "effective_date": {"type": "string", "format": "date"},
    "report_period": {"type": ["string", "null"]},
    "cash_amount_per_share": {"type": ["number", "null"]},
    "cash_amount_total_cny": {"type": ["number", "null"]},
    "prior_total_shares": {"type": ["number", "null"]},
    "post_total_shares": {"type": ["number", "null"]},
    "share_change_count": {"type": ["number", "null"]},
    "share_change_ratio": {"type": ["number", "null"]},
    "event_state": {"type": "string"},
    "share_count_effective": {"type": "boolean"},
    "shareholder_yield_effective": {"type": "boolean"},
    "source_id": {"type": "string"},
    "source_adapter": {"type": "string"},
    "source_document_id": {"type": ["string", "null"]},
    "source_location": {"type": ["string", "null"]},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "source_row_hash": {"type": "string"},
    "raw_fields_json": {"type": "string"},
    "authority": {"const": "DATA_AND_RESEARCH_EVIDENCE_ONLY"},
    "trade_authority": {"const": "NONE"}
  },
  "additionalProperties": true
}
