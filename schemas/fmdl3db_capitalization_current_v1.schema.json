{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-os.local/schemas/fmdl3db_capitalization_current_v1.schema.json",
  "title": "FMDL-3D-B Effective Share Count and Capitalization Current Row",
  "type": "object",
  "required": [
    "symbol",
    "name",
    "exchange",
    "board",
    "price_as_of_date",
    "capitalization_state",
    "state_reason",
    "source_release_id",
    "lineage_id",
    "authority",
    "trade_authority"
  ],
  "properties": {
    "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"},
    "name": {"type": "string", "minLength": 1},
    "exchange": {"type": "string", "enum": ["SH", "SZ", "BJ"]},
    "board": {"type": "string"},
    "price_as_of_date": {"type": "string", "format": "date"},
    "price_source_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "close": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "price_row_hash": {"type": ["string", "null"]},
    "price_record_quality": {"type": ["string", "null"]},
    "price_data_status": {"type": ["string", "null"]},
    "share_effective_date": {"type": ["string", "null"], "format": "date"},
    "total_shares": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "float_a_shares": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "limited_a_shares": {"type": ["number", "null"], "minimum": 0},
    "total_market_cap_cny": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "float_market_cap_cny": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "share_source_id": {"type": ["string", "null"]},
    "share_source_row_hash": {"type": ["string", "null"]},
    "capitalization_state": {
      "enum": [
        "VALID",
        "VALID_WITH_WARNING",
        "PRICE_UNAVAILABLE",
        "SHARE_SOURCE_UNAVAILABLE",
        "NO_EFFECTIVE_SHARE_ROW",
        "FUTURE_ONLY_SHARE_ROWS",
        "INVALID_SHARE_VALUES",
        "UNIVERSE_OR_SNAPSHOT_CONFLICT",
        "CONTROLLED_QUARANTINE"
      ]
    },
    "state_reason": {"type": "string", "minLength": 1},
    "attempt_count": {"type": "integer", "minimum": 0},
    "source_error_type": {"type": ["string", "null"]},
    "source_error_message": {"type": ["string", "null"]},
    "universe_row_hash": {"type": ["string", "null"]},
    "source_release_id": {"type": "string", "minLength": 1},
    "source_universe_version": {"type": "string", "minLength": 1},
    "source_snapshot_version": {"type": "string", "minLength": 1},
    "lineage_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority": {"const": "DATA_AND_RESEARCH_EVIDENCE_ONLY"},
    "trade_authority": {"const": "NONE"}
  },
  "additionalProperties": true
}
