{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-os.local/schemas/fmdl4d_thesis_record_v1.schema.json",
  "title": "FMDL-4D Thesis and Attribution Record",
  "type": "object",
  "required": [
    "thesis_record_id", "symbol", "name", "thesis_version", "source_as_of",
    "company_thesis_status", "security_thesis_readiness", "position_action",
    "portfolio_role", "thesis_summary", "variant_perception", "earnings_drivers",
    "risks", "open_gates", "catalyst_ids", "prove_kill_ids", "evidence_ids",
    "research_id", "transition_id", "return_attribution", "decision_attribution",
    "lessons", "feedback_proposal_ids", "next_review_gate", "semantic_hash",
    "authority", "trade_authority"
  ],
  "properties": {
    "thesis_record_id": {"type": "string", "pattern": "^FMDL4D-TH-[0-9]{6}\\.(SH|SZ|BJ)-[a-f0-9]{16}$"},
    "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"},
    "name": {"type": "string", "minLength": 1},
    "thesis_version": {"type": "string", "pattern": "^FMDL4D-TV[0-9]+-[0-9]{8}$"},
    "source_as_of": {"type": "string", "format": "date"},
    "company_thesis_status": {"enum": ["INTACT_UNTESTED_BASELINE", "WATCH_UNTESTED_EXPECTATIONS_OR_QUALITY_GATE"]},
    "security_thesis_readiness": {"const": "NOT_DECISION_GRADE_PENDING_CURRENT_PRICE_AND_SCENARIO"},
    "position_action": {"const": "WAIT_FOR_PROOF"},
    "portfolio_role": {"const": "UNASSIGNED_NO_EXPOSURE"},
    "thesis_summary": {"type": "string", "minLength": 20},
    "variant_perception": {"type": "string", "minLength": 10},
    "earnings_drivers": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "risks": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "open_gates": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "catalyst_ids": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "prove_kill_ids": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "research_id": {"type": "string"},
    "transition_id": {"type": "string"},
    "return_attribution": {"type": "object"},
    "decision_attribution": {"type": "object"},
    "lessons": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "feedback_proposal_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
    "next_review_gate": {"type": "object"},
    "semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority": {"const": "THESIS_TRACKING_ATTRIBUTION_AND_FEEDBACK_PROPOSALS_ONLY"},
    "trade_authority": {"const": "NONE"}
  },
  "additionalProperties": false
}
