{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FMDL-3D-D Shareholder Return Current",
  "type": "object",
  "required": ["symbol", "market_as_of_date", "shareholder_return_state", "dividend_source_state", "share_ledger_state", "complete_shareholder_yield", "authority", "trade_authority"],
  "properties": {
    "symbol": {"type": "string"},
    "name": {"type": ["string", "null"]},
    "market_as_of_date": {"type": "string", "format": "date"},
    "close": {"type": ["number", "null"]},
    "total_market_cap_cny": {"type": ["number", "null"]},
    "implemented_cash_dividend_per_share_ttm": {"type": ["number", "null"]},
    "implemented_cash_dividend_total_cny_ttm": {"type": ["number", "null"]},
    "dividend_yield_ttm": {"type": ["number", "null"]},
    "completed_buyback_yield_ttm": {"type": ["number", "null"]},
    "completed_issuance_dilution_yield_ttm": {"type": ["number", "null"]},
    "shareholder_yield_ttm": {"type": ["number", "null"]},
    "dividend_event_count_ttm": {"type": "integer", "minimum": 0},
    "buyback_event_count_ttm": {"type": "integer", "minimum": 0},
    "issuance_event_count_ttm": {"type": "integer", "minimum": 0},
    "dividend_source_state": {"type": "string"},
    "share_ledger_state": {"type": "string"},
    "shareholder_return_state": {"type": "string"},
    "complete_shareholder_yield": {"type": "boolean"},
    "source_release_ids_json": {"type": "string"},
    "lineage_ids_json": {"type": "string"},
    "authority": {"const": "DATA_AND_RESEARCH_EVIDENCE_ONLY"},
    "trade_authority": {"const": "NONE"}
  },
  "additionalProperties": true
}
