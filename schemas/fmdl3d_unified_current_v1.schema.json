{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-os.local/schemas/fmdl3d_unified_current_v1.schema.json",
  "title": "FMDL-3D Unified Current Row",
  "type": "object",
  "required": [
    "symbol",
    "name",
    "exchange",
    "board",
    "sector_profile",
    "market_as_of_date",
    "capitalization_state",
    "valuation_valid_metric_count",
    "shareholder_return_state",
    "component_release_ids_json",
    "row_hash",
    "authority",
    "trade_authority"
  ],
  "properties": {
    "symbol": {"type": "string", "pattern": "^[0-9]{6}\\.(SH|SZ|BJ)$"},
    "name": {"type": "string", "minLength": 1},
    "exchange": {"type": "string", "enum": ["SH", "SZ", "BJ"]},
    "board": {"type": "string"},
    "sector_profile": {"type": "string"},
    "market_as_of_date": {"type": "string", "format": "date"},
    "close": {"type": ["number", "null"]},
    "total_shares": {"type": ["number", "null"]},
    "float_a_shares": {"type": ["number", "null"]},
    "total_market_cap_cny": {"type": ["number", "null"]},
    "float_market_cap_cny": {"type": ["number", "null"]},
    "capitalization_state": {"type": "string"},
    "pe_ttm": {"type": ["number", "null"]},
    "pe_ttm_state": {"type": "string"},
    "earnings_yield_ttm": {"type": ["number", "null"]},
    "earnings_yield_ttm_state": {"type": "string"},
    "pb": {"type": ["number", "null"]},
    "pb_state": {"type": "string"},
    "ps_ttm": {"type": ["number", "null"]},
    "ps_ttm_state": {"type": "string"},
    "fcf_yield_ttm": {"type": ["number", "null"]},
    "fcf_yield_ttm_state": {"type": "string"},
    "ev_sales_ttm": {"type": ["number", "null"]},
    "ev_sales_ttm_state": {"type": "string"},
    "ev_operating_income_ttm": {"type": ["number", "null"]},
    "ev_operating_income_ttm_state": {"type": "string"},
    "valuation_valid_metric_count": {"type": "integer", "minimum": 0, "maximum": 7},
    "valuation_decision_grade_metric_count": {"type": "integer", "minimum": 0, "maximum": 7},
    "implemented_cash_dividend_per_share_ttm": {"type": ["number", "null"]},
    "implemented_cash_dividend_total_cny_ttm": {"type": ["number", "null"]},
    "dividend_yield_ttm": {"type": ["number", "null"]},
    "completed_buyback_yield_ttm": {"type": ["number", "null"]},
    "completed_issuance_dilution_yield_ttm": {"type": ["number", "null"]},
    "shareholder_yield_ttm": {"type": ["number", "null"]},
    "shareholder_return_state": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]},
    "complete_shareholder_yield": {"type": "boolean"},
    "capitalization_lineage_id": {"type": "string"},
    "valuation_row_hash": {"type": "string"},
    "shareholder_event_lineage_ids_json": {"type": "string"},
    "component_release_ids_json": {"type": "string"},
    "row_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authority": {"const": "DATA_AND_RESEARCH_EVIDENCE_ONLY"},
    "trade_authority": {"const": "NONE"}
  },
  "additionalProperties": false
}
