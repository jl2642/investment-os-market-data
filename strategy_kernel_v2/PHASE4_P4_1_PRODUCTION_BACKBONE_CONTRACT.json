    "run_receipt_root": "operating_current/runs/",
    "domain_pointer_root": "operating_current/domains/",
    "must_expose_stale_or_missing_domains": true,
    "user_facing_daily_control_should_read_this_surface": true
  },
  "backlog_policy": {
