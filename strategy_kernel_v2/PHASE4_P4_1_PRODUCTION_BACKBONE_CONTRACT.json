    "p4_0_status": "COMPLETE_ACCEPTED",
    "phase4_effective_forward_execution_hold": true
  },
  "objective": "Repair the low-risk operating-data and research publication backbone so forward validation can consume fresh, observable, QC-passed future evidence without using protected main merges as the daily data transport.",
  "authority_model": {
    "governance_canonical": {
      "branch": "main",
      "owns": [
        "CODE_AND_WORKFLOWS",
        "MODEL_AND_STRATEGY_CONTRACTS",
        "SCHEMAS_AND_GOVERNANCE",
        "FORMAL_CANDIDATE_MEMBERSHIP",
        "PROTECTED_REAL_ECONOMIC_STATE",
        "PROTECTED_SIMULATION_ECONOMIC_STATE",
        "USER_APPROVED_STATE_CHANGES"
      ]
    },
    "operating_current": {
      "branch": "operating-current",
      "authoritative_path_prefix": "operating_current/",
      "owns": [
        "LATEST_QC_PASSED_PUBLIC_DATA_RUN_POINTERS",
        "LATEST_QC_PASSED_RESEARCH_RUN_POINTERS",
        "CROSS_DOMAIN_WATERMARK_INDEX",
        "OPERATING_RUN_RECEIPTS_AND_FAILURE_VISIBILITY"
      ],
      "inherited_non_operating_paths_authoritative": false,
      "may_mutate_protected_economic_state": false
    }
  },
  "publication_semantics": {
    "successful_validated_run_may_update_operating_current_pointer": true,
    "successful_operating_pointer_update_requires_main_merge": false,
    "source_result_commit_must_exist_before_pointer_update": true,
    "pointer_must_bind_exact_source_commit": true,
    "pointer_must_record_source_workflow_and_run": true,
    "pointer_must_record_data_watermark": true,
    "pointer_must_record_qc_status": true,
    "pointer_must_record_protected_mutation_counts": true,
    "failed_run_may_replace_current_pointer": false,
    "blocked_or_stale_run_may_silently_advance_pointer": false,
    "no_op_may_preserve_existing_pointer": true,
    "source_result_branches_remain_evidence": true,
    "low_risk_operating_result_pr_required": false,
    "direct_push_to_protected_main": false
  },
  "initial_domains": [
    {
      "domain_id": "A_SHARE_FULL_MARKET",
      "sources": [
        "fmdl-daily-production.yml",
        "fmdl-2b4-full-rebase.yml"
      ],
      "current_payload": "market/history/factors/screening result commit",
      "protected_state": false
    },
    {
      "domain_id": "PORTFOLIO_MARKS",
      "sources": [
        "wp2_r_market_marks_refresh.yml"
      ],
      "current_payload": "market marks and valuation run pointer only",
      "protected_state": false,
      "protected_real_or_sim_economic_identity_source": "main"
    },
    {
      "domain_id": "CANDIDATE_WEEKLY_OBSERVATION",
      "sources": [
        "wp3_r_weekly_screen.yml"
      ],
      "current_payload": "observation-only weekly Candidate screen",
      "formal_candidate_membership_mutation": false
    },
    {
      "domain_id": "RESEARCH_D2",
      "sources": [
        "research-queue-d2-auto-consumer.yml"
      ],
      "current_payload": "D2 research and liveness operating state",
      "formal_candidate_membership_mutation": false
    },
    {
      "domain_id": "CROSS_MARKET_LIMITED",
      "sources": [
        "round3-cross-market-limited-production.yml"
      ],
      "current_payload": "bounded HK/US market and research operating state",
      "formal_candidate_membership_mutation": false
    }
